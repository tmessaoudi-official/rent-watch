# rent-watch — environment template. Copy to `.env` and fill in.
#
# THESE ARE LIVE SETTINGS. This preamble used to say the opposite — "nothing reads these yet, the
# adapters and the CLI do not exist" — and that was true when the file was written and false by the
# time anyone deployed. Every key below is read by running code today: `scout` reads them through
# `getenv()`, and `compose.yaml` substitutes the deployment ones itself before the container starts.
# A stale "this is only a sketch" notice on a live configuration file is worse than no notice, so it
# is gone.
#
# **Duplicate keys are a silent misconfiguration: the LAST occurrence wins.** Measured, not assumed
# — a scratch stack with `IMAP_PORT=143` above `IMAP_PORT=993` starts the container with 993. So
# editing a key in place does nothing if a second copy of it sits further down, which is exactly the
# shape this file shipped in until 2026-08-22. Fix the duplicate; never add one.
#
# `.env` is gitignored; THIS file is the committed template and carries no real values.
# CLAUDE.md hard rule 7: secrets live here and nowhere else — never in config/, never in a
# fixture, never in a commit message, never in a log line. Keep the two files in sync: a key
# added to `.env` and not to this template is invisible to the next person who deploys.

# ── Where the state lives ───────────────────────────────────────────────────────
# The seen-set, the price history and the run log. Deleting this file makes the next run
# RE-NOTIFY EVERYTHING, and the price history is not reconstructible — a listing only ever
# shows its CURRENT rent. Back it up; do not put it somewhere a cleanup job will find.
# NOT under var/: that tree is documented as container-lifetime scratch for Claude reports and
# PreCompact handoffs, so `rm -rf var/` is an entirely reasonable thing for someone to do. The
# seen-set and the price history are the opposite of scratch — see
# CLAUDE.md § "Credentials & stateful data", which names this path.
RENT_WATCH_DB=state/rent-watch.sqlite3

# ── Email-alert ingestion (the PRIMARY path for private portals) ────────────────
# CLAUDE.md hard rule 4 — this is within ToS, defeats anti-bot because there is no bot, and
# fires on publication rather than on a polling interval.
#
# CORRECTED 2026-08-22. This used to read "a DEDICATED mailbox, not your personal one: rent-watch
# reads and MARKS messages". The second half was never true of the implementation: `ImapMailbox`
# opens the folder with EXAMINE rather than SELECT and fetches with BODY.PEEK[], so the server
# itself refuses any modification — nothing here can flag, move, delete, or even mark a message
# read. A false reason for a good rule is worse than no reason, because it is the half a reader
# checks and stops.
#
# The rule survives on the reason that IS true: SCOPE. The parser reads every message in the folder
# it is pointed at, so pointing it at a personal INBOX means it parses personal mail. A dedicated
# mailbox is one way to bound that; the cheaper one on Gmail is a filter that labels the portal
# alerts and IMAP_MAILBOX set to that label, which is a folder to IMAP and leaves the inbox alone.
IMAP_HOST=imap.example.net
IMAP_PORT=993
IMAP_USER=alertes-immo@example.net
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# OR, instead of IMAP entirely: point at a directory of .eml files. Needs no credentials at all, and
# is how the whole email path is exercised offline. Drop a real alert in here and it becomes a
# regression fixture. IMAP_HOST is used only when this is empty.
MAILBOX_DIR=

# ── Notification channel ────────────────────────────────────────────────────────
# RULED 2026-08-07 (Q9): `console` is always available; `ntfy` and `email` are both supported and
# both optional. Enable a channel in `config/criteria.json` under `notify.channels`, then fill its
# block here. Enabling one WITHOUT its credential is a refusal, not a silent no-op — but scoped
# (Q28): the process still starts if another channel is usable, and alerts you about the broken one.
#
# The ntfy TOPIC IS A SECRET — anyone who knows it can read every notification. It travels as a URL
# PATH SEGMENT rather than a named parameter, so it cannot be masked by name: `Redact` masks the
# segment following the configured NTFY_SERVER host. If you self-host under a name that is not
# `ntfy.*`, set NTFY_SERVER here and nowhere else, so the mask knows what to look for.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram is NOT a supported channel under the Q9 ruling (console / ntfy / email). These are left
# commented so that filling them cannot produce silence with no error — an unsupported channel name
# in `notify.channels` is a config validation error.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# SMTP_TRANSPORT chooses HOW email leaves. Leave it empty for the sensible default: `smtp` when
# SMTP_HOST is set, `sendmail` otherwise.
#   smtp     — speak SMTP directly with the credentials below
#   sendmail — hand off to the host MTA (right under a compose stack that runs one)
#   file     — write .eml files to MAIL_OUTBOX and send nothing. No server, no credential; this is
#              how `scout test-notify` produces a real, readable message offline.
SMTP_TRANSPORT=
MAIL_OUTBOX=var/outbox
SMTP_HOST=
SMTP_PORT=587
# tls (implicit, port 465) · starttls (upgrade after EHLO, port 587) · none (REFUSED unless the host
# is loopback — a credential on a plaintext connection to a remote host is a credential on the wire)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rent-watch@localhost
SMTP_TO=

# ── Transit enrichment (door-to-door commute, spec §6) ──────────────────────────
# The IDFM / PRIM key travels as a QUERY PARAMETER, which is why RentWatch\Core\Redact masks
# `key=` and `apikey=` before any adapter error text reaches the database or a notification.
IDFM_API_KEY=

# ── Income eligibility ──────────────────────────────────────────────────────────
# RULED 2026-08-07 (Q6): income-eligibility checking is OFF and NOTHING READS THIS. It is commented
# out rather than left blank so the template does not solicit personal financial data for a feature
# that does not run — the point of answering Q6 "off" was to keep the figure out of the process
# entirely, not merely out of git. Uncomment only if you overturn Q6; it is your revenu fiscal de
# référence, N-2, and it must never reach a commit, a fixture or a log.
#RFR_N2=

# ── Timezone ────────────────────────────────────────────────────────────────────
# RULED 2026-08-07 (Q34). The digest's daily emission is specified as "08:00 local", and a Docker
# container without TZ runs UTC — so "local" silently meant 10:00 Paris in summer. Every displayed
# timestamp and the digest boundary read this; `scout doctor` prints the resolved local time.
TZ=Europe/Paris

# ── The deployment (Q8: Docker, a mounted `state/`, `scout run --watch`) ─────────
# Read by `compose.yaml`, not by `scout` — Compose substitutes them before the container exists, so
# they belong in this file even though no `getenv()` names them. They were missing until 2026-08-22
# while compose's own comment said to set them here, which is the exact drift the preamble warns
# about: a key you are told to set and cannot discover.
#
# The image runs as its own uid and `./state` is a BIND MOUNT, so the directory belongs to whoever
# created it on the host. Mismatch them and PDO cannot create the database — observed, running the
# real container: the process died on an uncaught driver error. Set these to your own ids
# (`id -u` / `id -g`); 1000 is the ordinary first user on a Debian/Ubuntu VPS, which is what Q8
# prescribes. Equivalent one-liner if you would rather not persist them:
#   RW_UID=$(id -u) RW_GID=$(id -g) docker compose up -d
RW_UID=1000
RW_GID=1000

# Bounds `scout run --watch` to n passes and then exits cleanly — a diagnostic for a first
# deployment ("does one full pass work on this host?"), NOT a way to schedule. Leave it unset for
# normal operation: the watcher owning its own cadence is the whole of Q8's argument against cron,
# and Q37's pacing lives inside the loop rather than between invocations. The banner states the
# bound on every start, so a forgotten one is visible rather than mysterious.
#RENT_WATCH_MAX_PASSES=
#
# One more variable exists and is deliberately NOT listed as a setting: `RENT_WATCH_OFFLINE`, which
# `tests/bootstrap.php` sets so `CurlHttpClient` refuses every third-party host. It is a test seam.
# Setting it in a deployment would silently disable every source while health stayed plausible.

# ── Watcher liveness (Q27) ──────────────────────────────────────────────────────
# `scout run --watch` emits a low-priority heartbeat this often, whether or not anything matched.
# Without it, a dead watcher and a quiet rental market produce byte-identical output: nothing.
HEARTBEAT_HOURS=24
